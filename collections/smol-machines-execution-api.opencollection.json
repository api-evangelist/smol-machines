          },
          "http": {
            "method": "POST",
            "url": "https://api.smolmachines.com/api/v1/sandboxes/:id/run",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Sandbox name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This creates a temporary overlay from the image and runs the command."
        }
      ]
    }
  ],
